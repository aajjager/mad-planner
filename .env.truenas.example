# Copy this file to .env on TrueNAS and replace every example value.
POSTGRES_DB=madplanner
POSTGRES_USER=madplanner
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Create this dataset before starting Mad Planner.
MADPLANNER_DATA_PATH=/mnt/tank/apps/mad-planner/postgres

# Use 0.0.0.0 to reach Mad Planner from other devices on your home network.
MADPLANNER_BIND_ADDRESS=0.0.0.0
MADPLANNER_PORT=8080
