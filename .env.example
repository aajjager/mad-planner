# Local development defaults. Copy this file to .env before running Compose.
POSTGRES_DB=madplanner
POSTGRES_USER=madplanner
POSTGRES_PASSWORD=change-me-for-local-development
# Compose uses the database service name (`db`) as the hostname.
DATABASE_URL=postgresql+psycopg://madplanner:change-me-for-local-development@db:5432/madplanner
MADPLANNER_PORT=8080
MADPLANNER_MEDIA_PATH=/mnt/tank/apps/mad-planner/media
